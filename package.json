{
  "name": "quanta",
  "productName": "Quanta",
  "version": "0.1.0",
  "description": "Quanta —— 实时监控 DeepSeek API token 消耗与余额的桌面悬浮仪表盘",
  "main": "src/main.js",
  "scripts": {
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "typecheck": "tsc -p renderer/tsconfig.json --noEmit",
    "start": "npm run build:renderer && electron .",
    "test": "node --test --test-force-exit \"tests/*.test.js\"",
    "dist": "npm run build:renderer && electron-builder --win",
    "license:gen": "node scripts/gen-license.js"
  },
  "author": "Quanta",
  "license": "MIT",
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "com.local.quanta",
    "productName": "Quanta",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quanta",
      "artifactName": "Quanta-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Quanta-Portable-${version}.exe"
    }
  }
}
